  m_Name: TutorialLevel1
  m_EditorClassIdentifier: 
  name: Villager
  artwork: {fileID: 0}
  sentences:
  - text: Hello there! I will teach you how to attack beasts.
    duration: 1.9
    waitForInput: 0
  - text: You will need to tap either side of the screen when a beast enters one
      of the round targets.
    duration: 1.9
    waitForInput: 0
  - text: Let's see it in practice! Wait for the first beast to enter the target
      on the ground.
    duration: 0
    waitForInput: 0
  - text: To attack beasts on the ground, press the right side of the screen.
    duration: 0
    waitForInput: 1
  - text: Great! Now wait for the next one.
    duration: 1.3
    waitForInput: 0
  - text: To attack beasts on the air, press the left side of the screen.
    duration: 0
    waitForInput: 1
  - text: Well done! Now use what you've learned to get through the next wave of
      beasts.
    duration: 14.9
    waitForInput: 0
  - text: Great job!
    duration: 1.4
    waitForInput: 0
  - text: Watch out though. There is a new type of beast incoming.
    duration: 1.9
    waitForInput: 0
  - text: Once again, wait for it to enter the target on the ground.
    duration: 1.9
    waitForInput: 0
  - text: 'To defeat a butterfly you need to hold the attack.

      Hold the right
      side of the screen until the bar disapears.'
    duration: 0
    waitForInput: 1
  - text: 'Nice! '
    duration: 0.4
    waitForInput: 0
  - text: Now, wait again for the next enemy.
    duration: 0.4
    waitForInput: 0
  - text: Hold the left side of the screen until the bar disapears.
    duration: 0
    waitForInput: 1
  - text: Good job!
    duration: 3
    waitForInput: 0
  - text: Once again, defeat the next wave of beasts on your own.
    duration: 22.4
    waitForInput: 0
  - text: You are good at this!
    duration: 0.7
    waitForInput: 0
  - text: The final wave is incoming. Use everything you've learned to defeat it.
    duration: 17.7
    waitForInput: 0
  - text: Well done! You've now learned everything you need to know.
    duration: 1.4
    waitForInput: 0
